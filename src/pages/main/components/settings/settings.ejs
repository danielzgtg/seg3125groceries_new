<%# Wrapped by #settings %>
<aside>
    <div>
        <label>
            <input type="radio" name="category" id="category0" value="0" checked/>
            Any
        </label>
        <label>
            <input type="radio" name="category" id="category1" value="1"/>
            <%= localize("categories", "fruit") %>
        </label>
        <label>
            <input type="radio" name="category" id="category2" value="2"/>
            <%= localize("categories", "vegetable") %>
        </label>
        <label>
            <input type="radio" name="category" id="category3" value="3"/>
            <%= localize("categories", "meat") %>
        </label>
        <label>
            <input type="radio" name="category" id="category4" value="4"/>
            <%= localize("categories", "dairy") %>
        </label>
        <label>
            <input type="radio" name="category" id="category5" value="5"/>
            <%= localize("categories", "bakery") %>
        </label>
        <label>
            <input type="radio" name="category" id="category6" value="6"/>
            <%= localize("categories", "pantry") %>
        </label>
        <label>
            <input type="radio" name="category" id="category7" value="7"/>
            <%= localize("categories", "drink") %>
        </label>
    </div>
    <div>
        <label>
            <input type="checkbox" id="vegetarian" />
            Vegetarian
        </label>
        <label>
            <input type="checkbox" id="gluten-free" />
            Gluten-free
        </label>
        <label>
            <input type="checkbox" id="organic" />
            Organic
        </label>
        <label>
            <input type="checkbox" id="diabetic" />
            Diabetic-friendly
        </label>
        <label>
            <input type="checkbox" id="lactose-free" />
            Lactose-free
        </label>
    </div>
</aside>
